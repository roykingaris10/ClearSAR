# Azure Entra ID (App Registration)
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_TENANT_ID=your-tenant-id
AZURE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Anthropic Claude API
ANTHROPIC_API_KEY=your-anthropic-api-key

# Session secret (32+ character random string for cookie encryption)
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-characters

# Database
DATABASE_URL="file:./dev.db"

# Send mode: "draft" creates drafts in Outlook, "send" sends immediately
# Start with "draft" until you trust the AI responses.
MAIL_SEND_MODE=draft

# Your organisation details (used in templates)
ORGANISATION_NAME="Your Organisation Ltd"
DPO_NAME="Your Name"
DPO_EMAIL=dpo@example.com
